# QuickClip Server Environment Configuration

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Application Public URLs (Used for generating share links)
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# MongoDB Connection
# Example: mongodb://localhost:27017/quickclip or MongoDB Atlas URI
# If unconfigured in development, an embedded in-memory database will run automatically for zero-friction local testing.
MONGODB_URI=mongodb://localhost:27017/quickclip

# Storage Provider: "s3" or "local"
# When set to "local" (default if S3 keys not present), files are safely streamed to server disk storage.
# When set to "s3", Cloudflare R2 / AWS S3 direct-to-cloud presigned & multipart transfers are used.
STORAGE_PROVIDER=local

# Amazon S3 / Cloudflare R2 Configuration (Used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=quickclip-shares
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
# Set to "true" for Cloudflare R2 or MinIO, "false" for standard AWS S3
S3_FORCE_PATH_STYLE=true

# Upload and Expiry Limits
# Maximum upload size in bytes (1073741824 = 1 GB)
MAX_UPLOAD_SIZE_BYTES=1073741824

# Default share expiration in seconds (86400 = 24 hours)
DEFAULT_EXPIRY_SECONDS=86400

# Cleanup interval in minutes (how often to purge expired files & unfinished multipart uploads)
CLEANUP_INTERVAL_MINUTES=15
